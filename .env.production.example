# Production settings for docker/compose.yml. install-hubium.sh writes this file; to do it by
# hand, copy it to .env next to compose.yml and fill it in:
#   docker compose -f docker/compose.yml --env-file .env pull
#   docker compose -f docker/compose.yml --env-file .env up -d --wait
# (.env.example is for local development and does not suit this stack.)

# The release to run (a tag of ghcr.io/sharapov-outsource/hubium-lms) and the optional
# services: db (PostgreSQL), s3 (RustFS), caddy (HTTPS), media (video transcoding),
# mailpit (catches mail), clamav (virus scanning of uploads, ~3 GB of RAM), ai-local (Ollama
# with bge-m3 for the AI tutor's search, ~2 GB of RAM).
HUBIUM_VERSION=latest
COMPOSE_PROFILES=db,caddy,media,mailpit

# Public URLs. CONTENT_HOST must be another host: untrusted SCORM content runs there. With
# the caddy profile, Caddy obtains HTTPS certificates for them; all must point at the server.
APP_URL=https://lms.example.org
CONTENT_HOST=https://content.example.org

# 32+ random bytes each. Generate with: openssl rand -base64 32
APP_SECRET=
POSTGRES_PASSWORD=
# Your own PostgreSQL 16+ instead of the db profile:
# DATABASE_URL=postgresql://hubium:password@db.example.org:5432/hubium

# Files: fs keeps them in the data volume; s3 uses the s3 profile or any S3 service.
STORAGE_DRIVER=fs
# STORAGE_DRIVER=s3
# S3_PUBLIC_URL=https://files.example.org
# S3_SECRET_KEY=
# S3_ACCESS_KEY=hubium
# Another S3 service: S3_ENDPOINT, S3_REGION, S3_BUCKET as well

# Mail. Until this points at a real server, mail is caught by Mailpit (http://127.0.0.1:8025 on the host).
# SMTP_URL=smtp://user:password@smtp.example.org:587
# MAIL_FROM=Hubium LMS <no-reply@example.org>

# First administrator, created by the first start (change the password after signing in)
SEED_ADMIN_EMAIL=admin@example.org
SEED_ADMIN_PASSWORD=
# minimal (default) or demo: demo also adds sample courses and users
# SEED_PROFILE=minimal

# Without the caddy profile, the web server listens here for your reverse proxy
# HUBIUM_WEB_BIND=127.0.0.1:3000

# Live sessions: BigBlueButton or Jitsi
# BBB_URL=https://bbb.example.org/bigbluebutton/
# BBB_SECRET=
# JITSI_DOMAIN=meet.jit.si

# Web Push notifications: generate the keys with `npx web-push generate-vapid-keys`
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.org

# Virus scanning of uploads: tcp://clamav:3310 with the clamav profile, or your own clamd
# (tcp://host:3310, unix:///path/to/clamd.sock). While it is set and clamd is down, uploads
# are refused; files above CLAMAV_MAX_SCAN_MB are stored without a scan.
# CLAMAV_URL=tcp://clamav:3310
# CLAMAV_MAX_SCAN_MB=100
# CLAMAV_TIMEOUT_MS=20000

# Embeddings for the AI tutor's search, configured on the first start (Administration → AI
# changes them later). With the ai-local profile: http://ollama:11434/v1, bge-m3, and
# SSRF_ALLOW_HOSTS=ollama.
# AI_EMBEDDINGS_URL=http://ollama:11434/v1
# AI_EMBEDDINGS_MODEL=bge-m3
# AI_EMBEDDINGS_API_KEY=

# Proxies in front of the web server that add to X-Forwarded-For: 1 for Caddy or nginx,
# 2 with a CDN in front of them. The client address (audit log, quiz network rules) is
# taken that many entries from the right.
# TRUSTED_PROXY_HOPS=1

# Internal hosts the server may call, comma-separated (a local Ollama, an LTI tool on the LAN)
# SSRF_ALLOW_HOSTS=

# REST API requests per token and minute (120); a token for /api/metrics (Prometheus)
# API_RATE_LIMIT_PER_MIN=120
# METRICS_TOKEN=

# Log level for every service: debug, info (default), warn, error. Logs are JSON lines on
# stdout (docker compose logs); see docs/operations.md.
# LOG_LEVEL=info

# Tracing: spans of requests, jobs and database queries over OTLP/HTTP to a collector
# (Jaeger, Grafana Tempo, the OpenTelemetry Collector…). Off while the endpoint is empty.
# Log records of a traced request carry its trace_id.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer …
# share of new traces to keep, 0…1 (1)
# OTEL_TRACES_SAMPLER_ARG=0.1
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=production

# Sign-in with Google / Yandex ID / VK ID / Keycloak (optional); switch them on in
# Administration → Settings → Authentication. Other providers (OIDC, SAML, OAuth 2) are
# added in Administration → Single sign-on.
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_YANDEX_ID=
# AUTH_YANDEX_SECRET=
# AUTH_VK_ID=
# AUTH_VK_SECRET=
# AUTH_KEYCLOAK_ID=
# AUTH_KEYCLOAK_SECRET=
# realm URL, e.g. https://sso.example.org/realms/main
# AUTH_KEYCLOAK_ISSUER=
