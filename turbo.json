{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": ["NODE_ENV"],
  "globalDependencies": [".env"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL", "APP_URL", "APP_SECRET", "NEXT_TELEMETRY_DISABLED", "BUILD_COMMIT"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "DATABASE_URL",
        "TEST_DATABASE_URL",
        "APP_URL",
        "CONTENT_HOST",
        "APP_SECRET",
        "SMTP_URL",
        "AUTH_RATE_LIMIT",
        "S3_TEST_ENDPOINT",
        "FFMPEG_PATH",
        "FFPROBE_PATH",
        "LDAP_TEST_URL",
        "OLLAMA_URL",
        "CLAMAV_URL",
        "HUBIUM_LIVE_MODEL",
        "ANTHROPIC_BASE_URL",
        "CI"
      ],
      "passThroughEnv": ["S3_TEST_ACCESS_KEY", "S3_TEST_SECRET_KEY", "ANTHROPIC_API_KEY"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
