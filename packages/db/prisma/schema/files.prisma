// File storage model. A File addresses context/component/area/itemId/path/name
// and points to an immutable FileBlob. See docs/architecture.md §6.

enum FileStatus {
  PENDING
  READY
  QUARANTINED
}

model FileBlob {
  id         String   @id @default(uuid(7)) @db.Uuid
  storageKey String   @unique
  size       BigInt
  mimeType   String
  sha256     String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  files    File[]
  variants FileVariant[]

  @@index([sha256])
}

model File {
  id           String     @id @default(uuid(7)) @db.Uuid
  blobId       String     @db.Uuid
  contextId    String     @db.Uuid
  component    String
  area         String
  itemId       String     @default("")
  path         String     @default("/")
  name         String
  mimeType     String
  size         BigInt
  uploadedById String?    @db.Uuid
  status       FileStatus @default(READY)
  sortOrder    Int        @default(0)
  license      String?
  author       String?
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)

  blob       FileBlob      @relation(fields: [blobId], references: [id], onDelete: Restrict)
  context    Context       @relation(fields: [contextId], references: [id], onDelete: Cascade)
  uploadedBy User?         @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  variants   FileVariant[]

  @@unique([contextId, component, area, itemId, path, name])
  @@index([blobId])
}

model FileVariant {
  id      String @id @default(uuid(7)) @db.Uuid
  fileId  String @db.Uuid
  variant String
  blobId  String @db.Uuid

  file File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  blob FileBlob @relation(fields: [blobId], references: [id], onDelete: Restrict)

  @@unique([fileId, variant])
}

model UploadSession {
  id                String    @id @default(uuid(7)) @db.Uuid
  userId            String    @db.Uuid
  storageKey        String    @unique
  multipartUploadId String?
  size              BigInt
  mimeType          String
  expiresAt         DateTime  @db.Timestamptz(3)
  completedAt       DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}
