// Categories, courses, sections and activities. Category, Course and Activity share
// their primary key with Context (see access.prisma).

enum CourseFormat {
  TOPICS
  WEEKS
  SINGLE
}

enum GroupMode {
  NONE
  SEPARATE
  VISIBLE
}

enum ActivityVisibility {
  SHOWN
  HIDDEN
  STEALTH
}

enum CompletionMode {
  NONE
  MANUAL
  AUTO
}

model Category {
  id          String   @id @db.Uuid
  parentId    String?  @db.Uuid
  name        String
  description String   @default("")
  idNumber    String?  @unique
  sortOrder   Int      @default(0)
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  courses  Course[]
  context  Context    @relation("CategoryContext", fields: [id], references: [id], onDelete: Cascade)

  @@index([parentId, sortOrder])
}

model Course {
  id                 String                   @id @db.Uuid
  categoryId         String                   @db.Uuid
  fullName           String
  shortName          String                   @unique @db.Citext
  idNumber           String?                  @unique
  summary            String                   @default("")
  /// Catalog search document, kept up to date by triggers on Course and Category.
  tsv                Unsupported("tsvector")?
  imageFileId        String?                  @db.Uuid
  format             CourseFormat             @default(TOPICS)
  formatOptions      Json                     @default("{}")
  startDate          DateTime?                @db.Timestamptz(3)
  endDate            DateTime?                @db.Timestamptz(3)
  visible            Boolean                  @default(true)
  lang               String?
  enableCompletion   Boolean                  @default(true)
  completionSettings Json                     @default("{}")
  groupMode          GroupMode                @default(NONE)
  groupModeForced    Boolean                  @default(false)
  guestAccess        Boolean                  @default(false)
  settings           Json                     @default("{}")
  /// Values of the custom course fields, { [shortName]: string | boolean }.
  customFields       Json                     @default("{}")
  createdById        String?                  @db.Uuid
  deletedAt          DateTime?                @db.Timestamptz(3)
  createdAt          DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                 @updatedAt @db.Timestamptz(3)

  category          Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  context           Context            @relation("CourseContext", fields: [id], references: [id], onDelete: Cascade)
  sections          CourseSection[]
  activities        Activity[]
  enrolmentMethods  EnrolmentMethod[]
  enrolments        Enrolment[]
  groups            Group[]
  groupings         Grouping[]
  accesses          CourseAccess[]
  courseCompletions CourseCompletion[]
  calendarEvents    CalendarEvent[]
  gradeCategories   GradeCategory[]
  gradeItems        GradeItem[]
  notifications     Notification[]
  conversations     Conversation[]
  announcements     Announcement[]

  aiCourseFeatures   AiCourseFeature[]
  contentChunks      ContentChunk[]
  aiGenerations      AiGeneration[]
  tutorConversations TutorConversation[]
  scales             Scale[]

  @@index([categoryId])
  @@index([deletedAt])
  @@index([tsv], type: Gin)
  @@index([fullName(ops: raw("gin_trgm_ops"))], type: Gin)
}

model CourseSection {
  id           String   @id @default(uuid(7)) @db.Uuid
  courseId     String   @db.Uuid
  rank         String
  title        String   @default("")
  summary      String   @default("")
  visible      Boolean  @default(true)
  availability Json?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  course     Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  activities Activity[]

  @@index([courseId, rank])
}

model Activity {
  id                   String             @id @db.Uuid
  courseId             String             @db.Uuid
  sectionId            String             @db.Uuid
  moduleKey            String
  rank                 String
  name                 String
  intro                String             @default("")
  showIntro            Boolean            @default(false)
  visibility           ActivityVisibility @default(SHOWN)
  availability         Json?
  completionMode       CompletionMode     @default(NONE)
  completionRules      Json               @default("{}")
  completionExpectedAt DateTime?          @db.Timestamptz(3)
  groupMode            GroupMode          @default(NONE)
  groupingId           String?            @db.Uuid
  settings             Json               @default("{}")
  idNumber             String?
  version              Int                @default(1)
  createdById          String?            @db.Uuid
  deletedAt            DateTime?          @db.Timestamptz(3)
  createdAt            DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @db.Timestamptz(3)

  course             Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  section            CourseSection        @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  /// Group mode works with the groups of this grouping only.
  grouping           Grouping?            @relation(fields: [groupingId], references: [id], onDelete: SetNull)
  context            Context              @relation("ActivityContext", fields: [id], references: [id], onDelete: Cascade)
  completions        ActivityCompletion[]
  gradeItems         GradeItem[]
  assignSubmissions  AssignSubmission[]
  assignGrades       AssignGrade[]
  assignOverrides    AssignOverride[]
  assignUserFlags    AssignUserFlags[]
  assignParticipants AssignParticipant[]
  assignState        AssignState?
  gradingDefinitions GradingDefinition[]
  forumGrades        ForumGrade[]
  quizSlots          QuizSlot[]
  quizAttempts       QuizAttempt[]
  quizOverrides      QuizOverride[]
  forumDiscussions   ForumDiscussion[]
  forumSubscriptions ForumSubscription[]
  videoAsset         VideoAsset?
  videoProgress      VideoProgress[]
  bookChapters       BookChapter[]
  liveMeeting        LiveMeeting?
  liveAttendance     LiveAttendance[]
  liveRecordings     LiveRecording[]
  scormPackage       ScormPackage?
  scormAttempts      ScormAttempt[]

  contentChunks      ContentChunk[]
  gradingSuggestions GradingSuggestion[]

  @@index([courseId, sectionId, rank])
  @@index([moduleKey])
}

model CourseAccess {
  userId         String   @db.Uuid
  courseId       String   @db.Uuid
  lastAccessAt   DateTime @db.Timestamptz(3)
  lastActivityId String?  @db.Uuid

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, courseId])
}

/// A custom course field defined by administrators (values live in Course.customFields).
model CourseField {
  id        String   @id @default(uuid(7)) @db.Uuid
  shortName String   @unique
  name      Json
  type      String
  options   Json     @default("{}")
  required  Boolean  @default(false)
  /// Only people who may change locked fields (course:changelockedfields) set it.
  locked    Boolean  @default(false)
  /// Shown in the catalog and on the course description; otherwise only to editors.
  visible   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}
