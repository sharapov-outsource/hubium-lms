// mod-assign: submissions, grades with feedback, per-user date overrides (extensions).

enum AssignSubmissionStatus {
  NEW
  DRAFT
  SUBMITTED
  REOPENED
}

model AssignSubmission {
  id            String                 @id @default(uuid(7)) @db.Uuid
  activityId    String                 @db.Uuid
  userId        String                 @db.Uuid
  attemptNumber Int                    @default(0)
  status        AssignSubmissionStatus @default(NEW)
  onlineText    String                 @default("")
  latest        Boolean                @default(true)
  submittedAt   DateTime?              @db.Timestamptz(3)
  createdAt     DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime               @updatedAt @db.Timestamptz(3)

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([activityId, userId, attemptNumber])
  @@index([activityId, latest, status])
}

model AssignGrade {
  id            String   @id @default(uuid(7)) @db.Uuid
  activityId    String   @db.Uuid
  userId        String   @db.Uuid
  attemptNumber Int      @default(0)
  grade         Decimal? @db.Decimal(12, 5)
  feedback      String   @default("")
  graderId      String?  @db.Uuid
  gradedAt      DateTime @default(now()) @db.Timestamptz(3)

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation("AssignGradeUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([activityId, userId, attemptNumber])
}

model AssignOverride {
  id                   String    @id @default(uuid(7)) @db.Uuid
  activityId           String    @db.Uuid
  userId               String?   @db.Uuid
  groupId              String?   @db.Uuid
  dueAt                DateTime? @db.Timestamptz(3)
  cutoffAt             DateTime? @db.Timestamptz(3)
  allowSubmissionsFrom DateTime? @db.Timestamptz(3)
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([activityId, userId])
}
