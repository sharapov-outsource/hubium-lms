// mod-quiz: slots (fixed or random question), attempts with frozen question snapshots.

enum QuizSlotKind {
  FIXED
  RANDOM
}

enum QuizAttemptState {
  IN_PROGRESS
  OVERDUE
  FINISHED
  ABANDONED
}

model QuizSlot {
  id             String       @id @default(uuid(7)) @db.Uuid
  activityId     String       @db.Uuid
  page           Int          @default(1)
  slot           Int
  kind           QuizSlotKind @default(FIXED)
  questionId     String?      @db.Uuid
  categoryId     String?      @db.Uuid
  includeSubcats Boolean      @default(false)
  maxMark        Decimal      @default(1) @db.Decimal(12, 5)

  activity  Activity          @relation(fields: [activityId], references: [id], onDelete: Cascade)
  question  Question?         @relation(fields: [questionId], references: [id], onDelete: Restrict)
  category  QuestionCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  attempted QuestionAttempt[]

  @@unique([activityId, slot])
}

model QuizAttempt {
  id                 String           @id @default(uuid(7)) @db.Uuid
  activityId         String           @db.Uuid
  userId             String           @db.Uuid
  attemptNumber      Int
  state              QuizAttemptState @default(IN_PROGRESS)
  startedAt          DateTime         @default(now()) @db.Timestamptz(3)
  dueAt              DateTime?        @db.Timestamptz(3)
  finishedAt         DateTime?        @db.Timestamptz(3)
  sumGrades          Decimal?         @db.Decimal(12, 5)
  needsManualGrading Boolean          @default(false)
  preview            Boolean          @default(false)
  seed               Int

  activity  Activity          @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions QuestionAttempt[]

  @@unique([activityId, userId, attemptNumber, preview])
  @@index([state, dueAt])
}

model QuestionAttempt {
  id           String   @id @default(uuid(7)) @db.Uuid
  attemptId    String   @db.Uuid
  slot         Int
  page         Int      @default(1)
  questionId   String   @db.Uuid
  /// The quiz slot the question came from (random slots included); used by regrading.
  quizSlotId   String?  @db.Uuid
  snapshot     Json
  maxMark      Decimal  @db.Decimal(12, 5)
  response     Json?
  fraction     Decimal? @db.Decimal(12, 7)
  mark         Decimal? @db.Decimal(12, 5)
  needsGrading Boolean  @default(false)
  flagged      Boolean  @default(false)
  comment      String   @default("")
  gradedById   String?  @db.Uuid
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  attempt  QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Restrict)
  quizSlot QuizSlot?   @relation(fields: [quizSlotId], references: [id], onDelete: SetNull)

  @@unique([attemptId, slot])
  @@index([questionId])
}

model QuizOverride {
  id           String    @id @default(uuid(7)) @db.Uuid
  activityId   String    @db.Uuid
  /// For one person, or (groupId) for the members of a group.
  userId       String?   @db.Uuid
  groupId      String?   @db.Uuid
  openAt       DateTime? @db.Timestamptz(3)
  closeAt      DateTime? @db.Timestamptz(3)
  timeLimitSec Int?
  attempts     Int?

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  group    Group?   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([activityId, userId])
  @@unique([activityId, groupId])
}
