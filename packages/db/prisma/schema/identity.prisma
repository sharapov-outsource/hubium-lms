// Identity: Better Auth managed tables plus Hubium extensions.

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum UserKind {
  PERSON
  SERVICE
}

enum UserRelationKind {
  PARENT
  MENTOR
}

model User {
  id                 String         @id @default(uuid(7)) @db.Uuid
  email              String         @unique @db.Citext
  emailVerified      Boolean        @default(false)
  emailPlaceholder   Boolean        @default(false)
  username           String?        @unique @db.Citext
  displayUsername    String?
  name               String
  firstName          String         @default("")
  lastName           String         @default("")
  image              String?
  locale             String?
  timezone           String?
  theme              String?
  status             UserStatus     @default(ACTIVE)
  kind               UserKind       @default(PERSON)
  isSiteAdmin        Boolean        @default(false)
  mustChangePassword Boolean        @default(false)
  twoFactorEnabled   Boolean        @default(false)
  messagePrivacy     MessagePrivacy @default(COURSEMATES)
  /**
   * Local hour (0-23) when the daily email digest is sent.
   */
  digestHour         Int            @default(18)
  avatarFileId       String?        @db.Uuid
  customFields       Json           @default("{}")
  lastLoginAt        DateTime?      @db.Timestamptz(3)
  /// When the local password was last set; null without one. Drives password expiry.
  passwordChangedAt  DateTime?      @db.Timestamptz(3)
  /// Failed sign-ins since failedLoginAt (the first one in the lockout window).
  failedLoginCount   Int            @default(0)
  failedLoginAt      DateTime?      @db.Timestamptz(3)
  /// Sign-in with a password is refused until then (Administration → Settings → Security).
  lockedUntil        DateTime?      @db.Timestamptz(3)
  lastAccessAt       DateTime?      @db.Timestamptz(3)
  deletedAt          DateTime?      @db.Timestamptz(3)
  // Better Auth `admin` plugin primitives (ban/impersonation only; authorization is ours).
  role               String?
  banned             Boolean?       @default(false)
  banReason          String?
  banExpires         DateTime?      @db.Timestamptz(3)
  createdAt          DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @db.Timestamptz(3)

  sessions            Session[]
  accounts            Account[]
  twoFactors          TwoFactor[]
  passwordHistory     PasswordHistory[]
  knownDevices        KnownDevice[]
  recoveryPassphrases RecoveryPassphrase[]
  mentees             UserRelation[]           @relation("mentor")
  mentors             UserRelation[]           @relation("mentee")
  apiTokens           ApiToken[]
  policyAcceptances   PolicyAcceptance[]
  roleAssignments     RoleAssignment[]
  uploadedFiles       File[]
  uploadSessions      UploadSession[]
  settingsUpdated     SiteSetting[]
  enrolments          Enrolment[]
  groupMembers        GroupMember[]
  cohortMembers       CohortMember[]
  courseAccesses      CourseAccess[]
  activityCompletions ActivityCompletion[]
  courseCompletions   CourseCompletion[]
  calendarEvents      CalendarEvent[]
  calendarFeedToken   CalendarFeedToken?
  grades              Grade[]
  assignSubmissions   AssignSubmission[]
  assignGrades        AssignGrade[]            @relation("AssignGradeUser")
  assignTeamSubmits   AssignTeamSubmit[]
  assignFlags         AssignUserFlags[]        @relation("AssignUserFlagsUser")
  assignMarking       AssignUserFlags[]        @relation("AssignUserFlagsMarker")
  assignParticipants  AssignParticipant[]
  gradingInstances    GradingInstance[]
  forumRatings        ForumRating[]            @relation("ForumRatingRater")
  forumGrades         ForumGrade[]             @relation("ForumGradeUser")
  forumGraded         ForumGrade[]             @relation("ForumGradeGrader")
  quizAttempts        QuizAttempt[]
  notifications       Notification[]           @relation("NotificationUser")
  notificationsActed  Notification[]           @relation("NotificationActor")
  notificationPrefs   NotificationPreference[]
  conversationMembers ConversationMember[]
  messages            Message[]
  blocks              UserBlock[]              @relation("Blocker")
  blockedBy           UserBlock[]              @relation("Blocked")
  announcements       Announcement[]
  forumDiscussions    ForumDiscussion[]
  forumPosts          ForumPost[]              @relation("ForumPostAuthor")
  forumSubscriptions  ForumSubscription[]
  forumReadStates     ForumReadState[]
  videoProgress       VideoProgress[]
  choiceAnswers       ChoiceAnswer[]
  feedbackResponses   FeedbackResponse[]
  liveAttendance      LiveAttendance[]
  scormAttempts       ScormAttempt[]

  aiConsents         AiConsent[]
  pushSubscriptions  PushSubscription[]
  tutorConversations TutorConversation[]

  @@index([status])
  @@index([lastName, firstName])
}

model Session {
  id             String   @id @default(uuid(7)) @db.Uuid
  token          String   @unique
  userId         String   @db.Uuid
  expiresAt      DateTime @db.Timestamptz(3)
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?  @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  userId                String    @db.Uuid
  providerId            String
  accountId             String
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  /// Text: Better Auth reserves some rows under a hash id (SAML replay protection)
  id         String   @id @default(uuid(7))
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
}

model TwoFactor {
  id                      String    @id @default(uuid(7)) @db.Uuid
  userId                  String    @db.Uuid
  secret                  String
  backupCodes             String
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime? @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Hashes of earlier passwords, newest first, for the "no reuse" rule of the password policy.
model PasswordHistory {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @db.Uuid
  hash      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Browsers and networks a user has signed in from; a new one triggers a notice.
model KnownDevice {
  id          String   @id @default(uuid(7)) @db.Uuid
  userId      String   @db.Uuid
  /// sha256 of browser, OS and network prefix (auth/devices.ts)
  fingerprint String
  label       String
  lastIp      String?
  firstSeenAt DateTime @default(now()) @db.Timestamptz(3)
  lastSeenAt  DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
}

/// Phrases a user with two-factor authentication keeps for a lost device. Each works once
/// instead of a code (auth/recovery.ts).
model RecoveryPassphrase {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @db.Uuid
  name      String
  hash      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Single sign-on through OIDC or SAML 2.0, and custom OAuth 2 providers. The first columns
/// are the ones Better Auth's SSO plugin reads (model "ssoProvider"); Hubium manages the rows
/// (auth/sso.ts).
model SsoProvider {
  id              String   @id @default(uuid(7)) @db.Uuid
  /// Slug in callback URLs
  providerId      String   @unique
  issuer          String
  /// Email domains matched to this provider (comma-separated), may be empty
  domain          String   @default("")
  /// JSON for Better Auth, without the client secret
  oidcConfig      String?
  samlConfig      String?
  /// OAuth 2 (protocol "oauth2"): endpoints, client id and scopes as JSON; these providers go
  /// through Better Auth's generic OAuth plugin instead of the SSO plugin
  oauthConfig     String?
  /// Administrator who added it
  userId          String   @db.Uuid
  organizationId  String?
  /// Button label on the sign-in page
  name            String
  protocol        String
  /// AES-GCM sealed OIDC client secret, merged into oidcConfig on read
  clientSecretEnc String?
  /// SAML: Hubium's signing key for this provider (sealed, merged into samlConfig on read)
  /// and its self-signed certificate, published in the service provider metadata
  spPrivateKeyEnc String?
  spCertificate   String?
  enabled         Boolean  @default(true)
  /// Create a Hubium account for a person who has none yet
  autoCreate      Boolean  @default(false)
  /// Sign in to an existing Hubium account with the same email
  linkByEmail     Boolean  @default(true)
  /// { email?, firstName?, lastName?, fields: { profileFieldShortName: attribute } }
  mapping         Json     @default("{}")
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
}

/// The LDAP directory people sign in with (one per site, id "default"; auth/ldap.ts).
model LdapServer {
  id              String    @id @default("default")
  enabled         Boolean   @default(false)
  /// ldap://host:389 or ldaps://host:636
  url             String
  startTls        Boolean   @default(false)
  /// PEM of a private CA, for ldaps:// and StartTLS
  caCertificate   String?
  bindDn          String    @default("")
  /// AES-GCM sealed password of the service account
  bindPasswordEnc String?
  baseDn          String
  /// {login} is replaced by the escaped login
  userFilter      String    @default("(&(objectClass=person)(uid={login}))")
  loginAttribute  String    @default("uid")
  /// A stable id, kept as the account id (entryUUID, objectGUID); the login when empty
  idAttribute     String    @default("entryUUID")
  /// { email, firstName, lastName, fields: { profileFieldShortName: attribute } }
  mapping         Json      @default("{}")
  autoCreate      Boolean   @default(false)
  linkByEmail     Boolean   @default(true)
  /// The nightly sync suspends accounts the directory no longer has
  suspendMissing  Boolean   @default(false)
  lastSyncAt      DateTime? @db.Timestamptz(3)
  lastSyncResult  Json?
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
}

model RateLimit {
  id          String @id @default(uuid(7)) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt
}

model UserRelation {
  id        String           @id @default(uuid(7)) @db.Uuid
  mentorId  String           @db.Uuid
  menteeId  String           @db.Uuid
  kind      UserRelationKind
  createdAt DateTime         @default(now()) @db.Timestamptz(3)

  mentor User @relation("mentor", fields: [mentorId], references: [id], onDelete: Cascade)
  mentee User @relation("mentee", fields: [menteeId], references: [id], onDelete: Cascade)

  @@unique([mentorId, menteeId])
  @@index([menteeId])
}

model UserProfileField {
  id              String   @id @default(uuid(7)) @db.Uuid
  shortName       String   @unique
  name            Json
  type            String
  options         Json     @default("{}")
  required        Boolean  @default(false)
  /// The person cannot change it on their own profile (set by administrators or imports).
  locked          Boolean  @default(false)
  visibleToOthers Boolean  @default(false)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
}

model ApiToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @db.Uuid
  name       String
  prefix     String
  tokenHash  String    @unique
  scopes     String[]
  expiresAt  DateTime? @db.Timestamptz(3)
  lastUsedAt DateTime? @db.Timestamptz(3)
  lastUsedIp String?
  revokedAt  DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Policy {
  id        String   @id @default(uuid(7)) @db.Uuid
  key       String   @unique
  name      Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  versions PolicyVersion[]
}

model PolicyVersion {
  id          String    @id @default(uuid(7)) @db.Uuid
  policyId    String    @db.Uuid
  content     Json
  mandatory   Boolean   @default(true)
  publishedAt DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  policy      Policy             @relation(fields: [policyId], references: [id], onDelete: Cascade)
  acceptances PolicyAcceptance[]

  @@index([policyId])
}

model PolicyAcceptance {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @db.Uuid
  versionId  String   @db.Uuid
  acceptedAt DateTime @default(now()) @db.Timestamptz(3)

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  version PolicyVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([userId, versionId])
}
