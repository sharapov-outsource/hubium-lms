// Site-wide settings, audit log, tags and user-visible background tasks.

enum EventOrigin {
  WEB
  API
  WORKER
  CLI
}

enum BackgroundTaskType {
  BACKUP
  RESTORE
  DUPLICATE
  IMPORT_MBZ
  IMPORT_QUESTIONS
  EXPORT_REPORT
  BULK_USERS
}

enum BackgroundTaskStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

/// A language pack installed from Administration → Languages: a new language, or a newer
/// version of one that ships with Hubium (it then takes that one's place).
model LanguagePack {
  code          String   @id
  /// Strings of the interface, as packages/i18n/messages/<code>.json holds them.
  core          Json
  /// Strings of activity modules: module key → { <key>: { ... } }.
  modules       Json     @default("{}")
  installedById String?  @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
}

model SiteSetting {
  key         String   @id
  value       Json
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

model EventLog {
  id            BigInt      @id @default(autoincrement())
  name          String
  actorId       String?     @db.Uuid
  realActorId   String?     @db.Uuid
  contextId     String?     @db.Uuid
  courseId      String?     @db.Uuid
  objectType    String?
  objectId      String?
  relatedUserId String?     @db.Uuid
  data          Json        @default("{}")
  origin        EventOrigin
  ip            String?
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)

  @@index([createdAt(ops: TimestampTzMinMaxOps)], type: Brin)
  @@index([courseId, createdAt])
  @@index([actorId, createdAt])
  // what happened to a person (LDAP sync looks up each account's last sync)
  @@index([relatedUserId, name, createdAt])
}

model Tag {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique @db.Citext
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  instances TagInstance[]
}

model TagInstance {
  id       String @id @default(uuid(7)) @db.Uuid
  tagId    String @db.Uuid
  itemType String
  itemId   String @db.Uuid

  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([tagId, itemType, itemId])
  @@index([itemType, itemId])
}

model BackgroundTask {
  id           String               @id @default(uuid(7)) @db.Uuid
  type         BackgroundTaskType
  status       BackgroundTaskStatus @default(QUEUED)
  progress     Int                  @default(0)
  contextId    String?              @db.Uuid
  createdById  String?              @db.Uuid
  input        Json                 @default("{}")
  result       Json?
  resultFileId String?              @db.Uuid
  log          Json                 @default("[]")
  error        String?
  pgBossJobId  String?
  startedAt    DateTime?            @db.Timestamptz(3)
  finishedAt   DateTime?            @db.Timestamptz(3)
  createdAt    DateTime             @default(now()) @db.Timestamptz(3)

  @@index([createdById, createdAt])
}
