// AI features (Phase 7): providers, per-feature config and limits, consent, usage log,
// retrieval chunks (pgvector + tsvector), quiz generation, grading suggestions, tutor.

enum AiProviderKind {
  ANTHROPIC
  OPENAI_COMPAT
  MOCK
}

enum AiFeature {
  QUIZGEN
  GRADING_ASSIST
  TUTOR
}

enum AiUsageStatus {
  OK
  ERROR
  REFUSED
  LIMITED
  /// Reserved by the quota check; replaced by the outcome when the call ends.
  PENDING
}

enum AiJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum GradingSuggestionStatus {
  PENDING
  APPLIED
  DISCARDED
}

enum TutorRole {
  USER
  ASSISTANT
}

model AiProvider {
  id           String         @id @default(uuid(7)) @db.Uuid
  kind         AiProviderKind
  name         String
  baseUrl      String?
  /// AES-GCM sealed API key (never returned to the browser).
  apiKeyEnc    String?
  /// { generation, cheap, premium } model ids
  models       Json
  /// { jsonSchema?, streaming? } for OpenAI-compatible servers
  capabilities Json           @default("{}")
  enabled      Boolean        @default(true)
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @db.Timestamptz(3)

  features AiFeatureConfig[]
}

model AiEmbeddingConfig {
  id        String         @id @default("default")
  kind      AiProviderKind
  baseUrl   String?
  model     String
  dims      Int            @default(1024)
  apiKeyEnc String?
  updatedAt DateTime       @updatedAt @db.Timestamptz(3)
}

model AiFeatureConfig {
  feature       AiFeature @id
  enabled       Boolean   @default(false)
  providerId    String?   @db.Uuid
  /// 'generation' | 'cheap' | 'premium' (provider role) or an explicit model id
  model         String    @default("generation")
  effort        String?
  /// { userDailyTokens?, courseMonthlyTokens?, perMinute? }
  limits        Json      @default("{}")
  noticeVersion Int       @default(1)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  provider AiProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
}

model AiCourseFeature {
  courseId String    @db.Uuid
  feature  AiFeature
  enabled  Boolean

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([courseId, feature])
}

model AiConsent {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @db.Uuid
  feature       AiFeature
  noticeVersion Int
  acceptedAt    DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, feature, noticeVersion])
}

model AiUsage {
  id               String        @id @default(uuid(7)) @db.Uuid
  feature          AiFeature
  userId           String?       @db.Uuid
  courseId         String?       @db.Uuid
  providerId       String?       @db.Uuid
  model            String
  inputTokens      Int           @default(0)
  outputTokens     Int           @default(0)
  cacheReadTokens  Int           @default(0)
  cacheWriteTokens Int           @default(0)
  durationMs       Int           @default(0)
  status           AiUsageStatus
  error            String?
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@index([courseId, createdAt])
  @@index([createdAt])
}

model ContentChunk {
  id             String                       @id @default(uuid(7)) @db.Uuid
  courseId       String                       @db.Uuid
  activityId     String?                      @db.Uuid
  /// 'activity' | 'course'
  sourceType     String
  sourceId       String
  chunkIndex     Int
  title          String
  text           String
  tokenCount     Int
  contentHash    String
  embeddingModel String
  /// HNSW cosine index "ContentChunk_embedding_hnsw_idx" lives in the migration SQL only.
  embedding      Unsupported("vector(1024)")?
  tsv            Unsupported("tsvector")?
  createdAt      DateTime                     @default(now()) @db.Timestamptz(3)

  course   Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  activity Activity? @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([sourceType, sourceId, chunkIndex])
  @@index([courseId])
  @@index([activityId])
  @@index([tsv], type: Gin)
}

model AiGeneration {
  id            String      @id @default(uuid(7)) @db.Uuid
  feature       AiFeature
  courseId      String      @db.Uuid
  activityId    String?     @db.Uuid
  requestedById String      @db.Uuid
  status        AiJobStatus @default(QUEUED)
  input         Json
  output        Json?
  error         String?
  acceptedCount Int         @default(0)
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @db.Timestamptz(3)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, createdAt])
}

model GradingSuggestion {
  id             String                  @id @default(uuid(7)) @db.Uuid
  activityId     String                  @db.Uuid
  submissionId   String                  @db.Uuid
  userId         String                  @db.Uuid
  requestedById  String                  @db.Uuid
  suggestedGrade Decimal?                @db.Decimal(12, 5)
  breakdown      Json
  feedbackDraft  String
  confidence     Float
  model          String
  status         GradingSuggestionStatus @default(PENDING)
  createdAt      DateTime                @default(now()) @db.Timestamptz(3)

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([submissionId, createdAt])
}

model TutorConversation {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @db.Uuid
  courseId  String   @db.Uuid
  title     String   @default("")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  messages TutorMessage[]

  @@index([userId, courseId, updatedAt])
}

model TutorMessage {
  id             String    @id @default(uuid(7)) @db.Uuid
  conversationId String    @db.Uuid
  role           TutorRole
  content        String
  /// [{ activityId, title, url }]
  citations      Json      @default("[]")
  usageId        String?   @db.Uuid
  /// -1 | 1
  rating         Int?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  conversation TutorConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
