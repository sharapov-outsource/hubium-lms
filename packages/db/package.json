{
  "name": "@hubium/db",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:diff": "prisma migrate diff --from-config-datasource --to-schema prisma/schema --exit-code",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@hubium/tooling": "workspace:*",
    "@types/node": "^24",
    "@types/pg": "8.23.1",
    "dotenv": "18.0.7",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "~5.9.3",
    "vitest": "5.0.4"
  }
}
