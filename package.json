{
  "name": "hubium",
  "private": true,
  "version": "1.0.0-rc.2",
  "license": "AGPL-3.0-only",
  "author": "Alexander S. <alexander@sharapov.biz>",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "depcruise": "pnpm --filter @hubium/depcruise depcruise",
    "licenses:check": "pnpm --filter @hubium/licenses check",
    "db:generate": "pnpm --filter @hubium/db generate",
    "db:migrate": "pnpm --filter @hubium/db migrate:deploy",
    "db:migrate:dev": "pnpm --filter @hubium/db migrate:dev",
    "db:seed": "pnpm --filter @hubium/core seed",
    "storage:init": "pnpm --filter @hubium/core storage:init",
    "postinstall": "node scripts/i18n-index.mjs && pnpm --filter @hubium/db generate",
    "i18n:index": "node scripts/i18n-index.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "turbo": "2.11.7",
    "typescript": "~7.0.2"
  }
}
