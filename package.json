{
  "name": "hubium",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "depcruise": "depcruise apps packages --config .dependency-cruiser.cjs",
    "db:generate": "pnpm --filter @hubium/db generate",
    "db:migrate": "pnpm --filter @hubium/db migrate:deploy",
    "db:migrate:dev": "pnpm --filter @hubium/db migrate:dev",
    "db:seed": "pnpm --filter @hubium/core seed",
    "postinstall": "pnpm --filter @hubium/db generate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "dependency-cruiser": "18.6.0",
    "turbo": "2.11.7",
    "typescript": "~5.9.3"
  }
}
