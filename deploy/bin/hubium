#!/bin/sh
# Hubium LMS launcher: `hubium web`, `hubium worker`, or a command of the CLI (`hubium help`).
# Settings come from the environment and from HUBIUM_ENV_FILE (default
# /etc/hubium/hubium.env), which Node reads itself; variables already set (by systemd or
# docker compose) take precedence over the file.
set -eu

self=$(readlink -f "$0" 2>/dev/null || echo "$0")
HUBIUM_HOME=${HUBIUM_HOME:-$(cd "$(dirname "$self")/.." && pwd)}
if [ -x "$HUBIUM_HOME/node/bin/node" ]; then
  NODE="$HUBIUM_HOME/node/bin/node"
else
  NODE=node
fi
ENV_FILE=${HUBIUM_ENV_FILE:-/etc/hubium/hubium.env}

# A local node of a cloud whose certificate a company's own authority signed
# (install-hubium.sh --hub-ca): Node.js trusts it besides the public ones, and besides
# those NODE_EXTRA_CA_CERTS names already.
if [ -n "${NODE_HUB_CA:-}" ]; then
  ca=${TMPDIR:-/tmp}/hubium-hub-ca.pem
  if printf '%s' "$NODE_HUB_CA" | base64 -d >"$ca.$$" 2>/dev/null; then
    if [ -n "${NODE_EXTRA_CA_CERTS:-}" ] && [ -r "$NODE_EXTRA_CA_CERTS" ] &&
      [ "$NODE_EXTRA_CA_CERTS" != "$ca" ]; then
      cat "$NODE_EXTRA_CA_CERTS" >>"$ca.$$"
    fi
    mv -f "$ca.$$" "$ca"
    export NODE_EXTRA_CA_CERTS="$ca"
  else
    rm -f "$ca.$$"
    echo "hubium: NODE_HUB_CA is not a base64 certificate; ignored" >&2
  fi
fi

run() {
  if [ ! -e "$ENV_FILE" ]; then
    exec "$NODE" "$@"
  elif [ -r "$ENV_FILE" ]; then
    exec "$NODE" --env-file="$ENV_FILE" "$@"
  else
    echo "hubium: cannot read $ENV_FILE; run it as root or as the hubium user (sudo -u hubium hubium ...)" >&2
    exit 1
  fi
}

case "${1:-}" in
  web)
    shift
    run "$HUBIUM_HOME/web/apps/web/server.js" "$@"
    ;;
  worker)
    shift
    run "$HUBIUM_HOME/worker/main.mjs" "$@"
    ;;
  healthcheck)
    # Container health: the web server or the worker, whichever this container runs.
    # shellcheck disable=SC2016 # JavaScript template literals
    exec "$NODE" -e '
      const urls = [
        `http://127.0.0.1:${process.env.PORT || 3000}/api/health`,
        `http://127.0.0.1:${process.env.WORKER_HEALTH_PORT || 3001}/healthz`,
      ];
      Promise.any(urls.map((u) => fetch(u).then((r) => (r.ok ? r : Promise.reject()))))
        .then(() => process.exit(0), () => process.exit(1));'
    ;;
  *)
    run "$HUBIUM_HOME/cli/hubium.mjs" "$@"
    ;;
esac
