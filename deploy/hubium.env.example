# Hubium LMS settings for an installation from the release archive (systemd).
# install-hubium.sh writes /etc/hubium/hubium.env from these; edit it there, then
#   systemctl restart hubium-web hubium-worker
# Values in quotes may contain spaces. See docs/operations.md for every variable.

NODE_ENV=production

# Public addresses. CONTENT_HOST must be a separate host: untrusted SCORM content runs there.
APP_URL=https://lms.example.org
CONTENT_HOST=https://content.example.org

# The web server listens here; Caddy (or your proxy) forwards APP_URL and CONTENT_HOST to it.
HOSTNAME=127.0.0.1
PORT=3000

# PostgreSQL 16+ with the vector, citext, pg_trgm and unaccent extensions
DATABASE_URL=postgresql://hubium:CHANGE-ME@127.0.0.1:5432/hubium

# 32+ random characters: openssl rand -base64 32. Keep it: it decrypts stored secrets.
APP_SECRET=

# Files: on this server (fs) or in S3-compatible storage (s3)
STORAGE_DRIVER=fs
STORAGE_FS_ROOT=/var/lib/hubium/files
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://storage.example.org
# S3_PUBLIC_URL=https://files.example.org
# S3_REGION=us-east-1
# S3_BUCKET=hubium
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Mail
SMTP_URL=smtp://user:password@smtp.example.org:587
MAIL_FROM="Hubium LMS <no-reply@example.org>"

# The first administrator, created by `hubium migrate --seed minimal` (change the password
# after signing in; the variable is only read while the administrator does not exist)
SEED_ADMIN_EMAIL=admin@example.org
SEED_ADMIN_PASSWORD=

# Video transcoding (the hubium-worker-media service)
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# Live sessions: BigBlueButton or Jitsi
# BBB_URL=https://bbb.example.org/bigbluebutton/
# BBB_SECRET=
# JITSI_DOMAIN=meet.jit.si
# JITSI_APP_ID=
# JITSI_APP_SECRET=

# LOG_LEVEL=info
