# Site addresses are the app's public URLs (APP_URL, CONTENT_HOST, S3_PUBLIC_URL).

{$APP_URL} {
	encode zstd gzip
	reverse_proxy web:3000 {
		flush_interval -1
	}
}

# Untrusted content (SCORM, raw HTML) on its own origin; the app only answers /c/* here.
{$CONTENT_HOST} {
	reverse_proxy web:3000
}

# Presigned S3 URLs only; the bucket itself is private. The Host header must reach the
# storage unchanged because the URL signature covers it.
{$S3_PUBLIC_URL} {
	reverse_proxy s3:9000
}
