# Copy to .env and adjust. All apps read this file in development.

# PostgreSQL (docker/compose.dev.yml exposes it on 5432)
DATABASE_URL=postgresql://hubium:hubium@localhost:5432/hubium

# Public base URL of the LMS
# Untrusted SCORM content is served from a separate origin (no LMS cookies there).
# In development 127.0.0.1 is a different origin from localhost.
CONTENT_HOST=http://127.0.0.1:3000
APP_URL=http://localhost:3000

# 32+ random bytes, base64. Generate with: openssl rand -base64 32
APP_SECRET=change-me-change-me-change-me-change-me

# Seed: initial site admin
SEED_ADMIN_EMAIL=admin@hubium.local
SEED_ADMIN_PASSWORD=Admin12345!

# ── Video (worker-media) ────────────────────────────────────────────────────────
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# ── Live sessions ───────────────────────────────────────────────────────────────
# BigBlueButton: API base URL and shared secret (bbb-conf --secret)
# BBB_URL=https://bbb.example.com/bigbluebutton/
# BBB_SECRET=
# Jitsi: defaults to meet.jit.si; for a self-hosted server with JWT auth set all three
# JITSI_DOMAIN=meet.example.com
# JITSI_APP_ID=
# JITSI_APP_SECRET=

# ── Web Push (PWA notifications) ──
# Generate once: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# ── Security ──
# Hosts on private networks that server-side requests may reach (AI endpoints, LTI JWKS),
# e.g. a self-hosted Ollama: SSRF_ALLOW_HOSTS=ollama,10.0.0.5
# SSRF_ALLOW_HOSTS=
# REST API: requests per minute per token
# API_RATE_LIMIT_PER_MIN=120
# Prometheus scrape endpoint /api/metrics (disabled when unset)
# METRICS_TOKEN=
