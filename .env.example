# Copy to .env and adjust. All apps read this file in development.

# PostgreSQL (docker/compose.dev.yml exposes it on 5432)
DATABASE_URL=postgresql://hubium:hubium@localhost:5432/hubium

# Public base URL of the LMS
APP_URL=http://localhost:3000

# 32+ random bytes, base64. Generate with: openssl rand -base64 32
APP_SECRET=change-me-change-me-change-me-change-me

# Seed: initial site admin
SEED_ADMIN_EMAIL=admin@hubium.local
SEED_ADMIN_PASSWORD=Admin12345!

# ── Video (worker-media) ────────────────────────────────────────────────────────
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# ── Live sessions ───────────────────────────────────────────────────────────────
# BigBlueButton: API base URL and shared secret (bbb-conf --secret)
# BBB_URL=https://bbb.example.com/bigbluebutton/
# BBB_SECRET=
# Jitsi: defaults to meet.jit.si; for a self-hosted server with JWT auth set all three
# JITSI_DOMAIN=meet.example.com
# JITSI_APP_ID=
# JITSI_APP_SECRET=
